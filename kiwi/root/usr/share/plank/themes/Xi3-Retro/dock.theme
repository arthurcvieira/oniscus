# Xi3 Retro: dark graphite shelf for Plank (GPL-3.0-or-later, original Oniscus work)
[PlankTheme]
TopRoundness=6
BottomRoundness=6
LineWidth=1
OuterStrokeColor=58;;66;;76;;255
FillStartColor=42;;48;;56;;235
FillEndColor=28;;32;;38;;220
InnerStrokeColor=255;;255;;255;;15

[PlankDockTheme]
HorizPadding=4
TopPadding=4
BottomPadding=4
ItemPadding=6
IndicatorSize=5
IconShadowSize=2
UrgentBounceHeight=1.6666666666666667
LaunchBounceHeight=0.625
FadeOpacity=1
ClickTime=300
UrgentBounceTime=600
LaunchBounceTime=600
ActiveTime=300
SlideTime=300
FadeTime=250
HideTime=240
GlowSize=30
GlowTime=10000
GlowPulseTime=2000
UrgentHueShift=150
ItemMoveTime=450
CascadeHide=true
