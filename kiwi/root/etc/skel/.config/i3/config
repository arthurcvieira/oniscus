# Oniscus: default i3 config, running inside the XFCE session.
# Bars: xfce4-panel on top and Polybar at the bottom, so there is no "bar {}" block.
# Dock: Plank on the left, hiding when a window touches it.

set $mod Mod4
font pango:Noto Sans 10

# Appearance
default_border pixel 2
default_floating_border pixel 2
hide_edge_borders smart

# Border colors from the dark Xi3 Retro theme (yellow accent)
# class                  border  bg      text    indicator child_border
client.focused          #f7c948 #f7c948 #121519 #ffe58f   #f7c948
client.focused_inactive #3a424c #2a3038 #e6e9ec #3a424c   #3a424c
client.unfocused        #3a424c #1c2026 #9aa4af #3a424c   #3a424c
client.urgent           #f28c28 #f28c28 #121519 #f28c28   #f28c28
client.background       #121519
gaps inner 6
gaps outer 0
# Room for the floating Polybar (34px tall + 14px margin)
gaps bottom 50

# Terminal, launchers and XFCE utilities
bindsym $mod+space exec rofi -show drun
bindsym $mod+Return exec xfce4-terminal
bindsym $mod+d exec rofi -show drun
bindsym $mod+Shift+d exec xfce4-appfinder
bindsym $mod+e exec thunar
bindsym Print exec xfce4-screenshooter -f
bindsym $mod+Shift+x exec i3lock -c 121519

# Volume and brightness keys are handled by xfce4-pulseaudio-plugin and xfce4-power-manager

# Exiting ends the whole XFCE session, not just i3
bindsym $mod+Shift+e exec xfce4-session-logout
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart

# Windows
bindsym $mod+Shift+q kill
floating_modifier $mod

bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

bindsym $mod+b split h
bindsym $mod+v split v
bindsym $mod+f fullscreen toggle
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+t layout toggle split
bindsym $mod+Shift+space floating toggle
bindsym $mod+Shift+t focus mode_toggle
bindsym $mod+a focus parent

# Workspaces
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

mode "resize" {
    bindsym h resize shrink width 10 px or 10 ppt
    bindsym j resize grow height 10 px or 10 ppt
    bindsym k resize shrink height 10 px or 10 ppt
    bindsym l resize grow width 10 px or 10 ppt
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

# XFCE windows that should float
for_window [class="Xfce4-notifyd"] floating enable, border none
for_window [class="Wrapper-2.0"] floating enable
for_window [class="Xfce4-appfinder"] floating enable
for_window [class="Xfce4-settings-manager"] floating enable
for_window [class="Xfce4-power-manager-settings"] floating enable
for_window [class="Pavucontrol"] floating enable
for_window [window_role="pop-up"] floating enable
for_window [window_type="dialog"] floating enable
no_focus [class="Xfce4-notifyd"]

# Autostart
# picom animates opening, closing and resizing windows
exec --no-startup-id picom --config ~/.config/picom/picom.conf -b
exec --no-startup-id nm-applet
exec --no-startup-id plank
exec_always --no-startup-id sh ~/.config/polybar/launch.sh
# Without xfdesktop, feh sets the wallpaper. onis reads the user's choice from
# ~/.config/oniscus/wallpaper and falls back to xi3.jpg
exec_always --no-startup-id onis wallpaper --apply

# Oniscus: menu and welcome screen (onis command)
bindsym $mod+Mod1+space exec --no-startup-id onis menu
for_window [title="^Oniscus Welcome$"] floating enable, resize set 960 660, move position center
# Terminal-first system: the session starts with one terminal, showing the
# welcome menu (with the installer on the live ISO) and then a shell
exec --no-startup-id onis welcome --autostart

# Oniscus: system-level AI agents. The Oniscus guide is linked into the agents'
# skill folders, Super+Ctrl+Shift+a opens the default agent and, when a program
# crashes, a notification offers the agent to investigate
bindsym $mod+Shift+Control+a exec --no-startup-id onis agent
exec --no-startup-id onis agent link
exec --no-startup-id onis agent watch-crashes
