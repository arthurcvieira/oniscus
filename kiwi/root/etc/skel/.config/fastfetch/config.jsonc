// Oniscus: fastfetch with the mascot and the brand colors.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "/usr/share/oniscus/logo.ansi",
    "type": "file-raw",
    "padding": { "right": 2 }
  },
  "display": {
    "color": { "keys": "#F7C948", "title": "#F7C948" },
    "separator": "  "
  },
  "modules": [
    "title",
    "separator",
    { "type": "os", "key": "os" },
    { "type": "kernel", "key": "kernel" },
    { "type": "wm", "key": "wm" },
    { "type": "shell", "key": "shell" },
    { "type": "terminal", "key": "terminal" },
    { "type": "cpu", "key": "cpu" },
    { "type": "memory", "key": "memory" },
    { "type": "disk", "key": "disk" },
    "break",
    "colors"
  ]
}
