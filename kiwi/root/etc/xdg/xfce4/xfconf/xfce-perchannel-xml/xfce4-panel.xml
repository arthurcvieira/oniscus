<?xml version="1.0" encoding="UTF-8"?>
<!--
  Oniscus top bar:
  menu | focused app | ... | wifi (nm-applet in the tray) | battery | clock | search
  The look comes from the Xi3 Retro theme (gtk.css). CPU and RAM are only in the bottom Polybar.
-->
<channel name="xfce4-panel" version="1.0">
  <property name="configver" type="int" value="2"/>
  <property name="panels" type="array">
    <value type="int" value="1"/>
    <property name="dark-mode" type="bool" value="true"/>
    <property name="panel-1" type="empty">
      <property name="position" type="string" value="p=6;x=0;y=0"/>
      <property name="position-locked" type="bool" value="true"/>
      <property name="length" type="double" value="100"/>
      <property name="size" type="uint" value="24"/>
      <property name="icon-size" type="uint" value="16"/>
      <property name="plugin-ids" type="array">
        <value type="int" value="1"/>
        <value type="int" value="2"/>
        <value type="int" value="3"/>
        <value type="int" value="5"/>
        <value type="int" value="6"/>
        <value type="int" value="8"/>
        <value type="int" value="7"/>
      </property>
    </property>
  </property>
  <property name="plugins" type="empty">
    <!-- Application menu: the distro mascot -->
    <property name="plugin-1" type="string" value="whiskermenu">
      <property name="button-icon" type="string" value="/usr/share/pixmaps/oniscus-menu.svg"/>
      <property name="show-button-title" type="bool" value="false"/>
    </property>
    <!-- Name of the focused application, updated by xi3-active-app -->
    <property name="plugin-2" type="string" value="genmon">
      <property name="command" type="string" value="xi3-active-app"/>
      <property name="update-period" type="int" value="500"/>
      <property name="use-label" type="bool" value="false"/>
      <property name="font" type="string" value="Noto Sans Bold 10"/>
    </property>
    <property name="plugin-3" type="string" value="separator">
      <property name="expand" type="bool" value="true"/>
      <property name="style" type="uint" value="0"/>
    </property>
    <!-- Tray: nm-applet (wifi) and background apps -->
    <property name="plugin-5" type="string" value="systray">
      <property name="square-icons" type="bool" value="true"/>
      <property name="icon-size" type="int" value="16"/>
    </property>
    <!-- Battery (xfce4-battery-plugin; Tumbleweed's xfce4-power-manager has no panel plugin) -->
    <property name="plugin-6" type="string" value="battery"/>
    <property name="plugin-8" type="string" value="clock">
      <property name="mode" type="uint" value="2"/>
      <property name="digital-layout" type="uint" value="3"/>
      <property name="digital-time-format" type="string" value="%a %-d %b   %H:%M"/>
    </property>
    <!-- Search: opens rofi -->
    <property name="plugin-7" type="string" value="launcher">
      <property name="items" type="array">
        <value type="string" value="xi3-search.desktop"/>
      </property>
    </property>
  </property>
</channel>
