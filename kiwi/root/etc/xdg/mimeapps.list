# Oniscus default applications. VLC opens video, music and playlists.
# Users override this in ~/.config/mimeapps.list.
[Default Applications]
video/mp4=vlc.desktop;
video/x-matroska=vlc.desktop;
video/webm=vlc.desktop;
video/ogg=vlc.desktop;
video/mpeg=vlc.desktop;
video/quicktime=vlc.desktop;
video/x-msvideo=vlc.desktop;
video/x-flv=vlc.desktop;
video/3gpp=vlc.desktop;
video/mp2t=vlc.desktop;
video/x-ms-wmv=vlc.desktop;
audio/mpeg=vlc.desktop;
audio/mp4=vlc.desktop;
audio/x-m4a=vlc.desktop;
audio/flac=vlc.desktop;
audio/x-flac=vlc.desktop;
audio/ogg=vlc.desktop;
audio/x-vorbis+ogg=vlc.desktop;
audio/opus=vlc.desktop;
audio/x-opus+ogg=vlc.desktop;
audio/wav=vlc.desktop;
audio/x-wav=vlc.desktop;
audio/aac=vlc.desktop;
audio/x-ms-wma=vlc.desktop;
audio/x-matroska=vlc.desktop;
audio/webm=vlc.desktop;
application/ogg=vlc.desktop;
application/x-matroska=vlc.desktop;
audio/x-mpegurl=vlc.desktop;
application/vnd.apple.mpegurl=vlc.desktop;
audio/x-scpls=vlc.desktop;
